cff-version: 1.2.0
message: "If you use this dataset, please cite the paper below."
type: dataset
title: "AutoSpecNER: A Fine-Grained Named Entity Recognition Dataset for Vehicle Specification Extraction"
authors:
  - family-names: Lee
    given-names: Jordan
  - family-names: Ventirozos
    given-names: Filippos
  - family-names: Abdullahm
    given-names: Abdirahman
